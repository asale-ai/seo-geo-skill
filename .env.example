# Copy to .env and fill in. .env is gitignored and must never be committed.

# ClawHub publishing token — create with `clawhub login`
CLAWHUB_API_KEY=

# crates.io token, only needed if you publish the crate
CARGO_API_KEY=

# --- Optional: API credentials the analysis commands can use ---
# GOOGLE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GSC_PROPERTY=https://example.com/
# GA4_PROPERTY_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# MOZ_API_KEY=
# BING_WEBMASTER_API_KEY=
# INDEXNOW_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
