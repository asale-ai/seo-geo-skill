# Copy to .env and fill in. .env is gitignored and must never be committed.

# ClawHub publishing token — create with `clawhub login`
CLAWHUB_API_KEY=

# crates.io token, only needed if you publish the crate
CARGO_API_KEY=

# npm token for @asale/seogeo, used by publish.sh.
# It MUST be an Automation token: npmjs.com -> Access Tokens -> Generate New
# Token -> Classic -> Automation. Publish and granular tokens still demand a
# one-time password (npm fails with EOTP), which an unattended release cannot
# supply. Pass --no-npm to release without publishing to npm.
NPM_TOKEN=

# --- Optional: API credentials the analysis commands can use ---
# GOOGLE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GSC_PROPERTY=https://example.com/
# GA4_PROPERTY_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# MOZ_API_KEY=
# BING_WEBMASTER_API_KEY=
# INDEXNOW_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
